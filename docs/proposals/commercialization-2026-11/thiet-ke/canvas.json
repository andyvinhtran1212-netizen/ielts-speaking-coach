 "notes": {
  "n1": {
   "fill": "teal",
   "text": "Đổi bảng màu: chọn một màn → nút Tweaks → Bảng màu (Xanh teal / Navy + đỏ mận). Bấm Play để đi qua lại giữa các màn bằng thanh điều hướng. Số liệu, tên người, giá đều là dữ liệu mẫu.",
   "w": 420,
   "x": 4080,
   "y": 0
  },
  "note-0fi7g6": {
   "text": "nếu chỗ này có 40 câu thì thiết kế thế nào",
   "w": 240,
   "x": 673,
   "y": 7704
  },
  "note-3aob1w": {
   "page": "bai-tap",
   "text": "các nhãn lựa chọn này cũng dùng tiếng Anh: highlight ...",
   "w": 240,
   "x": 3480,
   "y": 1377
  },
  "note-4n3pz0": {
   "text": "Các lớp học viên offline: thì có 5 khoá (dạng học viên này sẽ được cấp mã từ phía admin để truy cập vào khoá để làm bài tập về nhà: mình có thể phân quyền cho người học để truy cập vào một vài khoá học để luyện tập lại)\ncòn các khoá bán online: hiện tại dự kiến có:\n- khoá grammar\n- Khoá listening\n- Khoá reading\n- khoá writing\n- KHoá speaking\n- Khoá vocab skills + ideas",
   "w": 240,
   "x": 1432,
   "y": 319
  },
  "note-6ddnhb": {
   "page": "bai-tap",
   "text": "mấy góp ý này sửa chưa nhỉ",
   "w": 240,
   "x": 3241,
   "y": 817
  },
  "note-7472my": {
   "page": "bai-tap",
   "text": "chỉ cần cross out hoặc fade nhẹ, không cần để tiếng Việt \"đã dùng, câu 6\"",
   "w": 240,
   "x": 3182,
   "y": 549
  },
  "note-dnre9z": {
   "text": "Nếu giả sử người dùng resize khung cửa số thi, kéo qua kéo lại 2 bên giữa bài đọc và",
   "w": 240,
   "x": 985,
   "y": 7129
  },
  "note-dvecfk": {
   "page": "thanh-phan",
   "text": "nên nhìn giống cảnh báo hơn với các thông báo thế này\nNút nộp bài dùng màu đỏ (nếu là tin cảnh báo)",
   "w": 240,
   "x": 498,
   "y": 1699
  },
  "note-ibq9y1": {
   "page": "bai-tap",
   "text": "nếu là bài full test thì các nhãn chuyển thành tiếng Anh, ví dụ như cụm chọn từ ở đây",
   "w": 240,
   "x": 3864,
   "y": 722
  },
  "note-jbvx3r": {
   "page": "bai-tap",
   "text": "Dùng từ GIÁO VIÊN thay cho chữ thầy nhé",
   "w": 240,
   "x": 5658,
   "y": 4156
  },
  "note-k33m0f": {
   "page": "thanh-phan",
   "text": "chỗ này note vào thiết kế thêm tính năng: đặt 2 đầu A và B vào lặp lại liên tục",
   "w": 240,
   "x": 3151,
   "y": 2159
  },
  "note-o5nur9": {
   "text": "ở trong thư viện writing, đề bài có thể có tiêu đề\n(cái này có thể dò lại trong kho writing, cũng có thể note lại một task là rà lại các đề trong kho và đặt lại tên cho hợp lý; nhưng mình muốn tên bằng tiếng Anh)",
   "w": 240,
   "x": 1945,
   "y": 7011
  },
  "note-oen9bw": {
   "page": "thanh-phan",
   "text": "kiểm tra xem bộ icon này đủ cover cho toàn bộ web chưa",
   "w": 240,
   "x": 8508,
   "y": 3778
  },
  "note-p8y32o": {
   "text": "Gởi yêu cầu chấm lại: chỗ này có thể để lại bài yêu cầu chấm lại: học viên/ người dùng dùng cái này có thể chọn thêm một cái note nhỏ về lý do tại sao lại yêu cầu chấm lại)\n- sẵn tiện nhắc về việc chấm bài trên web: có 2 dạng: 1 dạng là ai chấm thẳng rồi trả luôn\n- một dạng còn lại là qua luồng duyệt của giáo viên rồi mới bám trả về: nếu dạng học viên học offline rồi được gán mã lên web thì sẽ rơi vào dạng này.",
   "w": 240,
   "x": 2052,
   "y": 8437
  },
  "note-qqhtng": {
   "page": "bai-tap",
   "text": "dùng màu nhìn có vẻ giống warning hơn",
   "w": 240,
   "x": 5826,
   "y": 3046
  },
  "note-rhdcm9": {
   "text": "dùng một tí indentation cho biết trang con nhé\nCó thể dùng collapsible tab",
   "w": 240,
   "x": -265,
   "y": 12950
  },
  "note-slqrhk": {
   "page": "bai-tap",
   "text": "nếu như là bài thi full test thì đừng để tiếng Việt, \"câu 5' -> có thể dùng Q5",
   "w": 240,
   "x": 3471,
   "y": 549
  },
