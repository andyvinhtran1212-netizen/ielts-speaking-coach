# Supabase — choose the development/staging project intended for this checkout.
# Match the frontend AVER_SUPABASE_* values to this project. Its public/anon key
# may reach the browser; its service key must remain server-only and uncommitted.
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_dev_public_or_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
# Railway / Supabase may provide postgres:// or postgresql:// URLs.
# The backend normalizes those to postgresql+asyncpg:// for async SQLAlchemy use.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-key
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

# Anthropic-primary routing (services/ai_router.py; docs/AI_PROVIDER_ROUTING.md).
# Claude is tried first; any Claude failure or a blank ANTHROPIC_API_KEY falls
# back to the feature's existing provider/model unchanged.
AI_PROVIDER_ORDER=anthropic,openai,gemini
# Speaking grading inherits this order (AI-0004 FR-005): Claude Sonnet 5.5
# first, then SPEAKING_GRADING_MODEL (Gemini 3.8), Haiku 4.5, Sonnet 5. Set it
# to "gemini" to restore the Gemini-primary chain. Other per-feature overrides:
# AI_PROVIDER_ORDER_<FEATURE>.
AI_PROVIDER_ORDER_SPEAKING_GRADING=
ANTHROPIC_MODEL_GRADING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Short Claude JSON workloads. Set each to claude-haiku-4-5-20251001 and
# restart the backend to roll back independently. Speaking fallbacks are unchanged.
VOCAB_ANALYSIS_MODEL=claude-haiku-5-5
D1_QUESTION_MODEL=claude-haiku-5-5
LISTENING_GIST_MODEL=claude-haiku-5-5

# Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-key.json

# App
ENVIRONMENT=development
# Serve /docs, /redoc and /openapi.json (1/true/yes/on). Local development
# only; unset/blank keeps them 404 as on staging and production.
ENABLE_API_DOCS=
# Staging only: hide E2E/QA test data (staging-e2e.averlearning.com accounts,
# QA/E2E/[STAGING] names) from normal list views. Ignored unless
# ENVIRONMENT=staging; keep false in production.
HIDE_TEST_DATA=false
MAX_SESSIONS_PER_USER_PER_DAY=24
MAX_AUDIO_DURATION_SECONDS=300

# Runtime Vocabulary edits invalidate the matching Next public cache tag.
# Set URL to this environment's own frontend and configure the SAME random
# secret as AVER_CACHE_REVALIDATION_SECRET in that Vercel environment.
# Keep both blank locally when no Next server is running (safe no-op).
NEXT_CACHE_REVALIDATION_URL=
AVER_CACHE_REVALIDATION_SECRET=
# Staging only: the frontend sits behind Vercel Authentication, which rejects
# the backend's call before the route verifies the signature. Set this to the
# Vercel project's "Protection Bypass for Automation" secret (sent as the
# x-vercel-protection-bypass header). Leave blank where the frontend is public.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Writing Task 1 prompt images live in the PUBLIC Supabase Storage bucket
# `writing-images` (create out-of-band: Supabase dashboard → Storage →
# New bucket → name `writing-images` → Public ✓). Override the name here
# only if you use a different bucket.
# WRITING_IMAGES_BUCKET=writing-images

# Student Writing L1-L3 default; rollback with gemini-3.5-flash + backend restart.
# L4-L5, Deep and explicit administrator choices retain their existing models.
WRITING_FLASH_MODEL=gemini-3.8-flash

# Sprint 11.1 — Listening module (DEBT-LISTENING-MODULE foundation 1/5).
# ELEVENLABS_API_KEY blank until Andy provisions the Creator plan
# ($22/mo). The render endpoint stays 503 + a feature flag (defense in
# depth) holds the gate until both are set.
ELEVENLABS_API_KEY=
LISTENING_AI_RENDER_ENABLED=false
LISTENING_AUDIO_BUCKET=listening-audio
