# Supabase — choose the development/staging project intended for this checkout.
# Match the frontend AVER_SUPABASE_* values to this project. Its public/anon key
# may reach the browser; its service key must remain server-only and uncommitted.
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_dev_public_or_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
# Railway / Supabase may provide postgres:// or postgresql:// URLs.
# The backend normalizes those to postgresql+asyncpg:// for async SQLAlchemy use.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-key
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key

# Anthropic-primary routing (services/ai_router.py; docs/AI_PROVIDER_ROUTING.md).
# Claude is tried first; any Claude failure or a blank ANTHROPIC_API_KEY falls
# back to the feature's existing provider/model unchanged.
AI_PROVIDER_ORDER=anthropic,openai,gemini
# Speaking grading inherits this order (AI-0004 FR-005): Claude Sonnet 5.5
# first, then SPEAKING_GRADING_MODEL (Gemini 3.8), Haiku 4.5, Sonnet 5. Set it
# to "gemini" to restore the Gemini-primary chain. Other per-feature overrides:
# AI_PROVIDER_ORDER_<FEATURE>.
AI_PROVIDER_ORDER_SPEAKING_GRADING=
ANTHROPIC_MODEL_GRADING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Admin overrides from /admin (AIOPS-0024) win over the variables above; each
# backend process re-reads them every AI_MODEL_OVERRIDE_TTL_SECONDS (30–60).
AI_MODEL_OVERRIDE_TTL_SECONDS=30

# Short Claude JSON workloads. Set each to claude-haiku-4-5-20251001 and
# restart the backend to roll back independently. Speaking fallbacks are unchanged.
VOCAB_ANALYSIS_MODEL=claude-haiku-5-5
D1_QUESTION_MODEL=claude-haiku-5-5
LISTENING_GIST_MODEL=claude-haiku-5-5

# Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-key.json

# App
ENVIRONMENT=development
# Serve /docs, /redoc and /openapi.json (1/true/yes/on). Local development
# only; unset/blank keeps them 404 as on staging and production.
ENABLE_API_DOCS=
# CORS origins are per deployment (services/cors_policy.py): development allows
# the localhost dev servers. On staging, 1/true/yes/on also allows localhost
# (e.g. a local frontend against the staging API). Ignored in production.
CORS_ALLOW_LOCALHOST=
# Staging only: hide E2E/QA test data (staging-e2e.averlearning.com accounts,
# QA/E2E/[STAGING] names) from normal list views. Ignored unless
# ENVIRONMENT=staging; keep false in production.
HIDE_TEST_DATA=false
# Every boolean and integer in this file must hold a valid value or be omitted: a blank
# value (VAR=) fails backend startup with a validation error.
# ADMINAAL2-0032: true blocks admin powers without a verified TOTP (AAL2);
# false = report-only. Set exactly false or omit; blank fails startup.
ADMIN_AAL2_ENFORCE=false
# ADMINAAL2-0032 Amendment 1: AAL2 lasts this many hours after the last TOTP
# (1–12, else 12); step-up window in minutes for role / suspend / revoke (1–15,
# else 15); step-up enforcement, true or false (anything else → false).
# Invalid values fall back with one startup error log; none disables a check.
ADMIN_AAL2_MAX_AGE_HOURS=12
ADMIN_STEP_UP_MINUTES=15
ADMIN_STEP_UP_ENFORCE=false
# Async-DB kill switch (grading + per-request auth layer). Set false or omit.
USE_ASYNC_DB=false
MAX_SESSIONS_PER_USER_PER_DAY=24
MAX_AUDIO_DURATION_SECONDS=300
# Per-user / per-IP paid-AI quotas. Keep each a positive integer:
# <= 0 removes the cap today and is config_invalid under AIBUDGET-0033 FR-006.
MAX_GRADINGS_PER_USER_PER_DAY=200
TTS_DAILY_LIMIT_PER_USER=200
TTS_IP_MAX_PER_MINUTE=60
LISTENING_GIST_DAILY_LIMIT_PER_USER=60
LISTENING_GIST_MAX_PER_MINUTE=6

# AIBUDGET-0033 monthly USD caps (services/ai_budget_config.py). Blank = the
# spec default (total 200, anthropic 100 soft; google/azure/openai/elevenlabs
# 20 hard). A set value that is not a number, or is <= 0, is config_invalid
# for that scope (hard scopes then refuse); it never means "unlimited".
AI_BUDGET_MONTHLY_USD_TOTAL=
AI_BUDGET_MONTHLY_USD_ANTHROPIC=
AI_BUDGET_MONTHLY_USD_GOOGLE=
AI_BUDGET_MONTHLY_USD_AZURE=
AI_BUDGET_MONTHLY_USD_OPENAI=
AI_BUDGET_MONTHLY_USD_ELEVENLABS=
# "enforce" (default; any other value also enforces) or "shadow" (staging only).
AI_BUDGET_MODE=enforce
# The three variables below (AI_KILL_SWITCH, OWNER_ALERT_EMAILS,
# RESEND_API_KEY) are read from the process environment only (Railway
# variables, or export in your shell). The backend does not load them from
# this file, and a non-blank value here fails startup (unknown Settings key).
# FR-007 kill switch, read at call time: refuses every paid AI call when ON.
# Only off/false/0/unset leave it off; ANY other value, a typo included, turns it ON.
# AI_KILL_SWITCH=off

# Daily Vocabulary/flashcard row-growth alert (error_logs warning).
ROW_GROWTH_ALERT_ENABLED=true
# Minimum 3600; a lower value fails startup.
ROW_GROWTH_ALERT_INTERVAL_SECONDS=86400
ROW_GROWTH_ALERT_STARTUP_DELAY_SECONDS=600
# Rows per user per table in 24h before alerting; minimum 1.
ROW_GROWTH_ALERT_THRESHOLD=500

# Owner security alerts (services/owner_alerts.py). Process environment only,
# like AI_KILL_SWITCH above; either unset → nothing is sent and one
# owner_alert_transport_unconfigured warning names the missing variable.
# Comma-separated recipients.
# OWNER_ALERT_EMAILS=
# Resend API key: server-only secret, never commit a real value.
# RESEND_API_KEY=

# Runtime Vocabulary edits invalidate the matching Next public cache tag.
# Set URL to this environment's own frontend and configure the SAME random
# secret as AVER_CACHE_REVALIDATION_SECRET in that Vercel environment.
# Keep both blank locally when no Next server is running (safe no-op).
NEXT_CACHE_REVALIDATION_URL=
AVER_CACHE_REVALIDATION_SECRET=
# Staging only: the frontend sits behind Vercel Authentication, which rejects
# the backend's call before the route verifies the signature. Set this to the
# Vercel project's "Protection Bypass for Automation" secret (sent as the
# x-vercel-protection-bypass header). Leave blank where the frontend is public.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Writing Task 1 prompt images live in the PRIVATE Supabase Storage bucket
# `writing-images` (create out-of-band: Supabase dashboard → Storage →
# New bucket → name `writing-images` → Public OFF; readers get signed URLs,
# docs/WRITING_IMAGE_PRIVATE_BUCKET.md). Override the name here only if you
# use a different bucket.
# WRITING_IMAGES_BUCKET=writing-images

# Student Writing L1-L3 default; rollback with gemini-3.5-flash + backend restart.
# L4-L5, Deep and explicit administrator choices retain their existing models.
WRITING_FLASH_MODEL=gemini-3.8-flash

# ElevenLabs: test-audio narrator and vocab TTS (engine="elevenlabs").
# The admin AI-render endpoint and its LISTENING_AI_RENDER_ENABLED flag were
# removed 2026-07-17; that variable is now an unknown key and fails startup.
ELEVENLABS_API_KEY=
LISTENING_AUDIO_BUCKET=listening-audio
