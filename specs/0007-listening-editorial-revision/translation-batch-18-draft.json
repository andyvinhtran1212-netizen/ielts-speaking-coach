  "items": [
    {"id":"reference:1.1","source_prompt":"Who bought a new laptop?","source_options":{"A":"John","B":"yesterday","C":"a new laptop","D":"a friend"},"prompt_vi":"Ai đã mua một chiếc máy tính xách tay mới?","options_vi":{"A":"John","B":"hôm qua","C":"một chiếc máy tính xách tay mới","D":"một người bạn"}},
    {"id":"reference:1.2","source_prompt":"What did Sarah write?","source_options":{"A":"her boss","B":"a long email","C":"this morning","D":"a letter"},"prompt_vi":"Sarah đã viết gì?","options_vi":{"A":"sếp của cô ấy","B":"một email dài","C":"sáng nay","D":"một lá thư"}},
    {"id":"reference:1.3","source_prompt":"Where did the students gather?","source_options":{"A":"after school","B":"the students","C":"in the library","D":"at home"},"prompt_vi":"Các học sinh đã tập trung ở đâu?","options_vi":{"A":"sau giờ học","B":"các học sinh","C":"trong thư viện","D":"ở nhà"}},
    {"id":"reference:1.4","source_prompt":"When will they start the project?","source_options":{"A":"next Tuesday","B":"next Monday","C":"next Wednesday","D":"next Friday"},"prompt_vi":"Họ sẽ bắt đầu dự án vào khi nào?","options_vi":{"A":"thứ Ba tuần tới","B":"thứ Hai tuần tới","C":"thứ Tư tuần tới","D":"thứ Sáu tuần tới"}},
    {"id":"reference:1.5","source_prompt":"Why did Mary cancel the meeting?","source_options":{"A":"the storm","B":"Mary was sick","C":"the meeting","D":"the rain"},"prompt_vi":"Vì sao Mary hủy cuộc họp?","options_vi":{"A":"cơn bão","B":"Mary bị ốm","C":"cuộc họp","D":"trời mưa"}},
    {"id":"reference:1.6","source_prompt":"How did Tom travel to Paris?","source_options":{"A":"by plane","B":"by train","C":"by car","D":"alone"},"prompt_vi":"Tom đi đến Paris bằng phương tiện gì?","options_vi":{"A":"máy bay","B":"tàu hỏa","C":"ô tô","D":"một mình"}},
    {"id":"reference:1.7","source_prompt":"When does the shop close on weekdays?","source_options":{"A":"8 pm","B":"6 pm","C":"7 pm","D":"9 pm"},"prompt_vi":"Cửa hàng đóng cửa lúc mấy giờ vào các ngày trong tuần?","options_vi":{"A":"8 giờ tối","B":"6 giờ tối","C":"7 giờ tối","D":"9 giờ tối"}},
    {"id":"reference:1.8","source_prompt":"What does Emma love doing?","source_options":{"A":"watching TV","B":"writing novels","C":"reading novels","D":"studying"},"prompt_vi":"Emma thích làm gì?","options_vi":{"A":"xem TV","B":"viết tiểu thuyết","C":"đọc tiểu thuyết","D":"học bài"}},
    {"id":"reference:1.9","source_prompt":"Who gave the test?","source_options":{"A":"the students","B":"the teacher","C":"Friday","D":"the principal"},"prompt_vi":"Ai đã tổ chức bài kiểm tra?","options_vi":{"A":"các học sinh","B":"giáo viên","C":"thứ Sáu","D":"hiệu trưởng"}},
    {"id":"reference:1.10","source_prompt":"When does the speaker NOT drink coffee?","source_options":{"A":"in the morning","B":"in the evening","C":"all day","D":"before bed"},"prompt_vi":"Khi nào người nói KHÔNG uống cà phê?","options_vi":{"A":"vào buổi sáng","B":"vào buổi tối","C":"cả ngày","D":"trước khi đi ngủ"}},
    {"id":"reference:G2","source_prompt":"Why are sea levels rising?","source_options":{"A":"heavy rainfall","B":"ocean currents","C":"global warming","D":"melting rivers"},"prompt_vi":"Vì sao mực nước biển đang dâng lên?","options_vi":{"A":"mưa lớn","B":"các dòng hải lưu","C":"sự nóng lên toàn cầu","D":"các dòng sông tan chảy"}},
